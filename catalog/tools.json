{
  "version": 1,
  "meta": {
    "id": "dev-centr/equivalence-rules-cli",
    "defaultBranch": "main",
    "catalogFile": "catalog/tools.sdl",
    "equivalenceDomain": "cli"
  },
  "contexts": [
    {
      "id": "windows/winget",
      "label": "Windows (winget)",
      "family": "windows",
      "packageManager": "winget",
      "detect": "where winget"
    },
    {
      "id": "windows/scoop",
      "label": "Windows (Scoop)",
      "family": "windows",
      "packageManager": "scoop",
      "detect": "where scoop"
    },
    {
