      "detect": "which pacman"
    },
    {
      "id": "linux/alpine/default",
      "label": "Alpine (apk)",
      "family": "linux",
      "packageManager": "apk",
      "detect": "which apk"
    },
    {
      "id": "linux/nix/default",
      "label": "Linux (Nix)",
      "family": "linux",
      "packageManager": "nix",
      "detect": "which nix"
    },
    {
      "id": "linux/guix/default",
      "label": "GNU Guix",
      "family": "linux",
      "packageManager": "guix",
      "detect": "which guix"
    },
    {
      "id": "linux/homebrew",
