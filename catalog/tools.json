      "label": "Windows (Chocolatey)",
      "family": "windows",
      "packageManager": "choco",
      "detect": "where choco"
    },
    {
      "id": "macos/homebrew",
      "label": "macOS (Homebrew)",
      "family": "macos",
      "packageManager": "homebrew",
      "detect": "which brew"
    },
    {
      "id": "macos/nix/default",
      "label": "macOS (Nix)",
      "family": "macos",
      "packageManager": "nix",
      "detect": "which nix"
    },
    {
      "id": "linux/debian/default",
      "label": "Debian/Ubuntu (apt)",
      "family": "linux",
      "packageManager": "apt",
      "detect": "which apt-get"
    },
    {
      "id": "linux/ubuntu/default",
      "label": "Ubuntu (apt)",
      "family": "linux",
      "packageManager": "apt",
