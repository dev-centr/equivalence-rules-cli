  "tools": [
    {
      "id": "turso",
      "name": "Turso CLI",
      "description": "Edge SQLite platform CLI for Turso databases and libSQL.",
      "categories": [
        "database",
        "backend",
        "edge"
      ],
      "homepage": "https://turso.tech",
      "docs": "https://docs.turso.tech/cli",
      "verifyCommand": "turso --version",
      "launchCommand": "turso",
      "install": [
        {
          "context": "linux/nix/default",
          "command": "nix profile install nixpkgs#turso-cli",
          "auditNote": "Immutable Nix profile install for turso-cli."
        },
        {
          "context": "macos/nix/default",
          "command": "nix profile install nixpkgs#turso-cli"
        },
        {
          "context": "windows/winget",
          "command": "winget install --id Chisel.Turso -e --accept-source-agreements --accept-package-agreements",
          "auditNote": "Turso CLI via winget (Chisel.Turso)."
        },
        {
          "context": "macos/homebrew",
          "command": "brew install tursodatabase/tap/turso"
        },
        {
          "context": "linux/homebrew",
          "command": "brew install tursodatabase/tap/turso"
        },
        {
          "context": "default/curl-script",
          "command": "curl -sSfL https://get.turso.tech/install.sh | bash",
          "auditNote": "Official Turso install script."
        }
      ]
    },
    {
      "id": "convex",
      "name": "Convex CLI",
      "description": "Backend-as-a-service CLI for Convex projects.",
      "categories": [
        "backend",
        "database",
        "serverless"
      ],
      "homepage": "https://www.convex.dev",
      "docs": "https://docs.convex.dev/cli",
      "verifyCommand": "npx convex --version",
      "launchCommand": "convex",
      "install": [
        {
          "context": "default/npm-global",
          "command": "npm install -g convex",
          "auditNote": "Global npm install; prefer pnpm dlx in projects when possible."
        },
        {
          "context": "default/pnpm-dlx",
          "command": "pnpm add -g convex"
        },
        {
          "context": "macos/homebrew",
          "command": "npm install -g convex",
          "auditNote": "Convex via npm; no native brew formula."
        }
      ]
    },
