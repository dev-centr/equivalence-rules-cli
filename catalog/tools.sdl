            docs "https://github.com/be5invis/Iosevka"
            install {
                method {
                    context "linux/nix/default"
                    command "nix" "profile" "install" "nixpkgs#iosevka"
                    mutable false
                }
                method {
                    context "macos/nix/default"
                    command "nix" "profile" "install" "nixpkgs#iosevka"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew" "install" "--cask" "font-iosevka"
                }
            }
        }

        tool {
            id "monaspace"
            name "GitHub Monaspace"
            description "GitHub Next OFL coding superfamily."
            categories "font" "typography"
            homepage "https://monaspace.githubnext.com/"
            docs "https://github.com/githubnext/monaspace"
            install {
                method {
                    context "macos/homebrew"
                    command "brew" "install" "--cask" "font-monaspace"
                }
            }
        }

        tool {
            id "nerd-fonts-jetbrains-mono"
            name "JetBrains Mono Nerd Font"
            description "Nerd Fonts patch of JetBrains Mono (CLI glyphs). Reserved-name patch, not a new foundry."
            categories "font" "typography"
            homepage "https://www.nerdfonts.com/"
            docs "https://github.com/ryanoasis/nerd-fonts"
            install {
                method {
                    context "linux/nix/default"
                    command "nix" "profile" "install" "nixpkgs#nerd-fonts.jetbrains-mono"
                    mutable false
                }
                method {
                    context "macos/nix/default"
                    command "nix" "profile" "install" "nixpkgs#nerd-fonts.jetbrains-mono"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew" "install" "--cask" "font-jetbrains-mono-nerd-font"
                }
                method {
                    context "windows/winget"
                    command "winget" "install" "--id" "DEVCOM.JetBrainsMonoNerdFont" "-e"
                    auditNote "Community WiX installer on winget, not an official JetBrains package."
                }
            }
        }
    }
}
