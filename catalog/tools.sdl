// CLI tool install catalog — source of truth for DevCentr and equivalence-engine --domain cli.
// Compiled to catalog/tools.json via scripts/compile-sdl.mjs

cliToolsCatalog {
    version 1

    meta {
        id "dev-centr/equivalence-rules-cli"
        defaultBranch "main"
        catalogFile "catalog/tools.sdl"
        equivalenceDomain "cli"
    }

    contexts {
        context {
            id "windows/winget"
            label "Windows (winget)"
            family "windows"
            packageManager "winget"
            format "winget"
            mutable true
            detect "where winget"
        }
        context {
            id "windows/scoop"
            label "Windows (Scoop)"
            family "windows"
            packageManager "scoop"
            format "scoop"
            mutable true
            detect "where scoop"
        }
        context {
            id "windows/choco"
            label "Windows (Chocolatey)"
            family "windows"
            packageManager "choco"
            format "choco"
            mutable true
            detect "where choco"
        }
        context {
            id "macos/homebrew"
            label "macOS (Homebrew)"
            family "macos"
            packageManager "homebrew"
            format "brew"
            mutable true
            detect "which brew"
        }
        context {
            id "macos/nix/default"
            label "macOS (Nix)"
            family "macos"
            packageManager "nix"
            format "nix"
            mutable false
            detect "which nix"
        }
        context {
            id "linux/debian/default"
            label "Debian/Ubuntu (apt)"
            family "linux"
            packageManager "apt"
            format "deb"
            mutable true
            detect "which apt-get"
        }
        context {
            id "linux/ubuntu/default"
            label "Ubuntu (apt)"
            family "linux"
            packageManager "apt"
            format "deb"
            mutable true
            inherits "linux/debian/default"
        }
        context {
            id "linux/fedora/default"
            label "Fedora/RHEL (dnf)"
            family "linux"
            packageManager "dnf"
            format "rpm"
            mutable true
            detect "which dnf"
        }
        context {
            id "linux/arch/default"
            label "Arch Linux (pacman)"
            family "linux"
            packageManager "pacman"
            format "pacman"
            mutable true
            detect "which pacman"
        }
        context {
            id "linux/alpine/default"
            label "Alpine (apk)"
            family "linux"
            packageManager "apk"
            format "apk"
            mutable true
            detect "which apk"
        }
        context {
            id "linux/nix/default"
            label "Linux (Nix)"
            family "linux"
            packageManager "nix"
            format "nix"
            mutable false
            detect "which nix"
        }
        context {
            id "linux/guix/default"
            label "GNU Guix"
            family "linux"
            packageManager "guix"
            format "guix"
            mutable false
            detect "which guix"
        }
        context {
            id "linux/homebrew"
            label "Linux (Homebrew)"
            family "linux"
            packageManager "homebrew"
            format "brew"
            mutable true
            detect "which brew"
        }
        context {
            id "default/npm-global"
            label "Node.js (npm global)"
            family "cross"
            packageManager "npm"
            format "npm"
            mutable true
            detect "which npm"
        }
        context {
            id "default/pnpm-dlx"
            label "Node.js (pnpm dlx one-shot)"
            family "cross"
            packageManager "pnpm"
            format "pnpm"
            mutable true
            detect "which pnpm"
        }
        context {
            id "default/curl-script"
            label "Official install script (curl)"
            family "cross"
            packageManager "script"
            format "script"
            mutable true
        }
    }

    tools {
        // ── Databases & BaaS ──────────────────────────────────────────────
        tool {
            id "turso"
            name "Turso CLI"
            description "Edge SQLite platform CLI for Turso databases and libSQL."
            categories "database" "backend" "edge"
            homepage "https://turso.tech"
            docs "https://docs.turso.tech/cli"
            verifyCommand "turso --version"
            launchCommand "turso"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#turso-cli"
                    mutable false
                    auditNote "Immutable Nix profile install for turso-cli."
                }
                method {
                    context "macos/nix/default"
                    command "nix profile install nixpkgs#turso-cli"
                    mutable false
                }
                method {
                    context "windows/winget"
                    command "winget install --id Chisel.Turso -e --accept-source-agreements --accept-package-agreements"
                    auditNote "Turso CLI via winget (Chisel.Turso)."
                }
                method {
                    context "macos/homebrew"
                    command "brew install tursodatabase/tap/turso"
                }
                method {
                    context "linux/homebrew"
                    command "brew install tursodatabase/tap/turso"
                }
                method {
                    context "default/curl-script"
                    command "curl -sSfL https://get.turso.tech/install.sh | bash"
                    fallback true
                    auditNote "Official Turso install script."
                }
            }
        }

        tool {
            id "convex"
            name "Convex CLI"
            description "Backend-as-a-service CLI for Convex projects."
            categories "backend" "database" "serverless"
            homepage "https://www.convex.dev"
            docs "https://docs.convex.dev/cli"
            verifyCommand "npx convex --version"
            launchCommand "convex"
            install {
                method {
                    context "default/npm-global"
                    command "npm install -g convex"
                    auditNote "Global npm install; prefer pnpm dlx in projects when possible."
                }
                method {
                    context "default/pnpm-dlx"
                    command "pnpm add -g convex"
                }
                method {
                    context "macos/homebrew"
                    command "npm install -g convex"
                    fallback true
                    auditNote "Convex via npm; no native brew formula."
                }
            }
        }

        tool {
            id "supabase"
            name "Supabase CLI"
            description "Local development and management CLI for Supabase."
            categories "database" "backend" "serverless"
            homepage "https://supabase.com"
            docs "https://supabase.com/docs/guides/cli"
            verifyCommand "supabase --version"
            launchCommand "supabase"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#supabase-cli"
                    mutable false
                }
                method {
                    context "macos/nix/default"
                    command "nix profile install nixpkgs#supabase-cli"
                    mutable false
                }
                method {
                    context "windows/scoop"
                    command "scoop bucket add supabase https://github.com/supabase/scoop-bucket.git && scoop install supabase"
                }
                method {
                    context "macos/homebrew"
                    command "brew install supabase/tap/supabase"
                }
                method {
                    context "default/npm-global"
                    command "npm install -g supabase"
                    fallback true
                }
            }
        }

        // ── Deploy & hosting ──────────────────────────────────────────────
        tool {
            id "vercel"
            name "Vercel CLI"
            description "Deploy and manage Vercel projects from the terminal."
            categories "deployment" "frontend" "hosting"
            homepage "https://vercel.com"
            docs "https://vercel.com/docs/cli"
            verifyCommand "vercel --version"
            launchCommand "vercel"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#vercel-cli"
                    mutable false
                }
                method {
                    context "macos/nix/default"
                    command "nix profile install nixpkgs#vercel-cli"
                    mutable false
                }
                method {
                    context "default/npm-global"
                    command "npm install -g vercel"
                }
                method {
                    context "default/pnpm-dlx"
                    command "pnpm add -g vercel"
                }
            }
        }

        tool {
            id "netlify"
            name "Netlify CLI"
            description "Build, deploy, and manage Netlify sites."
            categories "deployment" "frontend" "hosting"
            homepage "https://www.netlify.com"
            docs "https://docs.netlify.com/cli/get-started/"
            verifyCommand "netlify --version"
            launchCommand "netlify"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#netlify-cli"
                    mutable false
                }
                method {
                    context "default/npm-global"
                    command "npm install -g netlify-cli"
                }
            }
        }

        tool {
            id "flyctl"
            name "Fly.io CLI"
            description "Deploy and manage applications on Fly.io."
            categories "deployment" "backend" "hosting"
            homepage "https://fly.io"
            docs "https://fly.io/docs/flyctl/"
            verifyCommand "fly version"
            launchCommand "fly"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#flyctl"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install flyctl"
                }
                method {
                    context "windows/winget"
                    command "winget install Fly-io.flyctl"
                }
                method {
                    context "default/curl-script"
                    command "curl -L https://fly.io/install.sh | sh"
                    fallback true
                }
            }
        }

        tool {
            id "railway"
            name "Railway CLI"
            description "Deploy and manage Railway projects."
            categories "deployment" "hosting"
            homepage "https://railway.app"
            docs "https://docs.railway.com/develop/cli"
            verifyCommand "railway --version"
            launchCommand "railway"
            install {
                method {
                    context "default/npm-global"
                    command "npm install -g @railway/cli"
                }
                method {
                    context "macos/homebrew"
                    command "brew install railway"
                }
            }
        }

        tool {
            id "wrangler"
            name "Wrangler (Cloudflare)"
            description "Cloudflare Workers and Pages CLI."
            categories "deployment" "edge" "serverless"
            homepage "https://developers.cloudflare.com/workers/wrangler/"
            docs "https://developers.cloudflare.com/workers/wrangler/install-and-update/"
            verifyCommand "wrangler --version"
            launchCommand "wrangler"
            install {
                method {
                    context "default/npm-global"
                    command "npm install -g wrangler"
                }
            }
        }

        // ── VCS & Git hosting ─────────────────────────────────────────────
        tool {
            id "gh"
            name "GitHub CLI"
            description "Official GitHub command-line tool."
            categories "vcs" "git" "devops"
            homepage "https://cli.github.com"
            docs "https://cli.github.com/manual/"
            verifyCommand "gh --version"
            launchCommand "gh"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#gh"
                    mutable false
                }
                method {
                    context "macos/nix/default"
                    command "nix profile install nixpkgs#gh"
                    mutable false
                }
                method {
                    context "windows/winget"
                    command "winget install --id GitHub.cli -e"
                }
                method {
                    context "macos/homebrew"
                    command "brew install gh"
                }
                method {
                    context "linux/debian/default"
                    command "sudo mkdir -p /etc/apt/keyrings && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo dd of=/etc/apt/keyrings/githubcli-archive-keyring.gpg && echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\" | sudo tee /etc/apt/sources.list.d/github-cli.list && sudo apt update && sudo apt install gh -y"
                }
                method {
                    context "linux/fedora/default"
                    command "sudo dnf install gh -y"
                }
                method {
                    context "linux/arch/default"
                    command "sudo pacman -S github-cli --noconfirm"
                }
            }
        }

        tool {
            id "glab"
            name "GitLab CLI"
            description "Official GitLab command-line tool."
            categories "vcs" "git" "devops"
            homepage "https://gitlab.com/gitlab-org/cli"
            docs "https://gitlab.com/gitlab-org/cli/-/blob/main/docs/source/index.md"
            verifyCommand "glab --version"
            launchCommand "glab"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#glab"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install glab"
                }
                method {
                    context "windows/winget"
                    command "winget install --id GitLab.Glab -e"
                }
                method {
                    context "linux/debian/default"
                    command "sudo apt install glab -y"
                }
                method {
                    context "default/curl-script"
                    command "curl -s https://raw.githubusercontent.com/gitlab-org/cli/main/scripts/install.sh | sudo bash"
                    fallback true
                }
            }
        }

        // ── Cloud provider CLIs ───────────────────────────────────────────
        tool {
            id "aws"
            name "AWS CLI v2"
            description "Amazon Web Services command-line interface."
            categories "cloud" "devops" "backend"
            homepage "https://aws.amazon.com/cli/"
            docs "https://docs.aws.amazon.com/cli/"
            verifyCommand "aws --version"
            launchCommand "aws"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#awscli2"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install awscli"
                }
                method {
                    context "windows/winget"
                    command "winget install Amazon.AWSCLI"
                }
                method {
                    context "linux/debian/default"
                    command "curl \"https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip\" -o /tmp/awscliv2.zip && unzip -q /tmp/awscliv2.zip -d /tmp && sudo /tmp/aws/install"
                }
            }
        }

        tool {
            id "gcloud"
            name "Google Cloud CLI"
            description "Google Cloud Platform command-line tool."
            categories "cloud" "devops"
            homepage "https://cloud.google.com/sdk"
            docs "https://cloud.google.com/sdk/docs"
            verifyCommand "gcloud --version"
            launchCommand "gcloud"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#google-cloud-sdk"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install --cask google-cloud-sdk"
                }
                method {
                    context "default/curl-script"
                    command "curl -O https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz && tar -xf google-cloud-cli-linux-x86_64.tar.gz && ./google-cloud-sdk/install.sh --quiet"
                    fallback true
                }
            }
        }

        tool {
            id "az"
            name "Azure CLI"
            description "Microsoft Azure command-line interface."
            categories "cloud" "devops"
            homepage "https://learn.microsoft.com/cli/azure/"
            docs "https://learn.microsoft.com/cli/azure/"
            verifyCommand "az version"
            launchCommand "az"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#azure-cli"
                    mutable false
                }
                method {
                    context "windows/winget"
                    command "winget install Microsoft.AzureCLI"
                }
                method {
                    context "macos/homebrew"
                    command "brew install azure-cli"
                }
                method {
                    context "linux/debian/default"
                    command "curl -sL https://aka.ms/InstallAzureCLIDeb | sudo bash"
                }
            }
        }

        tool {
            id "doctl"
            name "DigitalOcean CLI"
            description "Manage DigitalOcean resources from the terminal."
            categories "cloud" "devops"
            homepage "https://docs.digitalocean.com/reference/doctl/"
            docs "https://docs.digitalocean.com/reference/doctl/how-to/install/"
            verifyCommand "doctl version"
            launchCommand "doctl"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#doctl"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install doctl"
                }
                method {
                    context "windows/winget"
                    command "winget install DigitalOcean.Doctl"
                }
            }
        }

        // ── Containers & orchestration ────────────────────────────────────
        tool {
            id "docker"
            name "Docker CLI"
            description "Container build and run tooling (Docker Desktop or Engine)."
            categories "containers" "devops"
            homepage "https://www.docker.com"
            docs "https://docs.docker.com/engine/reference/commandline/cli/"
            verifyCommand "docker --version"
            launchCommand "docker"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#docker"
                    mutable false
                    auditNote "Nix docker CLI only; Docker daemon may need separate setup."
                }
                method {
                    context "windows/winget"
                    command "winget install Docker.DockerDesktop"
                }
                method {
                    context "macos/homebrew"
                    command "brew install --cask docker"
                }
                method {
                    context "linux/debian/default"
                    command "curl -fsSL https://get.docker.com | sh"
                }
            }
        }

        tool {
            id "podman"
            name "Podman"
            description "Daemonless container engine compatible with Docker CLI."
            categories "containers" "devops"
            homepage "https://podman.io"
            docs "https://docs.podman.io"
            verifyCommand "podman --version"
            launchCommand "podman"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#podman"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install podman"
                }
                method {
                    context "linux/fedora/default"
                    command "sudo dnf install podman -y"
                }
                method {
                    context "linux/debian/default"
                    command "sudo apt install podman -y"
                }
            }
        }

        tool {
            id "kubectl"
            name "kubectl"
            description "Kubernetes cluster command-line tool."
            categories "kubernetes" "devops"
            homepage "https://kubernetes.io/docs/reference/kubectl/"
            docs "https://kubernetes.io/docs/tasks/tools/"
            verifyCommand "kubectl version --client"
            launchCommand "kubectl"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#kubectl"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install kubectl"
                }
                method {
                    context "windows/winget"
                    command "winget install Kubernetes.kubectl"
                }
            }
        }

        tool {
            id "helm"
            name "Helm"
            description "Kubernetes package manager."
            categories "kubernetes" "devops"
            homepage "https://helm.sh"
            docs "https://helm.sh/docs/intro/install/"
            verifyCommand "helm version"
            launchCommand "helm"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#kubernetes-helm"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install helm"
                }
                method {
                    context "default/curl-script"
                    command "curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash"
                    fallback true
                }
            }
        }

        // ── IaC ───────────────────────────────────────────────────────────
        tool {
            id "opentofu"
            name "OpenTofu"
            description "Open-source Terraform-compatible infrastructure as code tool."
            categories "iac" "devops" "cloud"
            homepage "https://opentofu.org"
            docs "https://opentofu.org/docs"
            verifyCommand "tofu version"
            launchCommand "tofu"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#opentofu"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install opentofu"
                }
                method {
                    context "windows/winget"
                    command "winget install OpenTofu.Tofu"
                }
                method {
                    context "default/curl-script"
                    command "curl -Lo /tmp/tofu_install.sh https://get.opentofu.org/install/opentofu.sh && sh /tmp/tofu_install.sh"
                    fallback true
                }
            }
        }

        // ── Language runtimes & package managers ──────────────────────────
        tool {
            id "nix"
            name "Nix"
            description "Purely functional package manager for reproducible, immutable dev environments."
            categories "package-manager" "immutable" "devops"
            homepage "https://nixos.org"
            docs "https://nixos.org/download.html"
            verifyCommand "nix --version"
            launchCommand "nix"
            install {
                method {
                    context "default/curl-script"
                    command "curl -L https://nixos.org/nix/install | sh -s -- --daemon"
                    auditNote "Official Nix installer; enables immutable profile installs for other tools."
                }
                method {
                    context "macos/homebrew"
                    command "brew install nix"
                }
            }
        }

        tool {
            id "mise"
            name "mise"
            description "Polyglot runtime version manager (successor patterns to asdf)."
            categories "version-manager" "toolchain"
            homepage "https://mise.jdx.dev"
            docs "https://mise.jdx.dev/getting-started.html"
            verifyCommand "mise --version"
            launchCommand "mise"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#mise"
                    mutable false
                }
                method {
                    context "default/curl-script"
                    command "curl https://mise.run | sh"
                }
                method {
                    context "macos/homebrew"
                    command "brew install mise"
                }
                method {
                    context "windows/winget"
                    command "winget install jdx.mise"
                }
            }
        }

        tool {
            id "uv"
            name "uv"
            description "Fast Python package and project manager."
            categories "python" "package-manager"
            homepage "https://docs.astral.sh/uv/"
            docs "https://docs.astral.sh/uv/getting-started/installation/"
            verifyCommand "uv --version"
            launchCommand "uv"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#uv"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install uv"
                }
                method {
                    context "windows/winget"
                    command "winget install astral-sh.uv"
                }
                method {
                    context "default/curl-script"
                    command "curl -LsSf https://astral.sh/uv/install.sh | sh"
                    fallback true
                }
            }
        }

        tool {
            id "deno"
            name "Deno"
            description "Secure JavaScript/TypeScript runtime."
            categories "javascript" "runtime"
            homepage "https://deno.com"
            docs "https://docs.deno.com/runtime/manual/tools/install"
            verifyCommand "deno --version"
            launchCommand "deno"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#deno"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install deno"
                }
                method {
                    context "default/curl-script"
                    command "curl -fsSL https://deno.land/install.sh | sh"
                }
            }
        }

        tool {
            id "bun"
            name "Bun"
            description "All-in-one JavaScript runtime, bundler, and package manager."
            categories "javascript" "runtime" "package-manager"
            homepage "https://bun.sh"
            docs "https://bun.sh/docs/installation"
            verifyCommand "bun --version"
            launchCommand "bun"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#bun"
                    mutable false
                }
                method {
                    context "default/curl-script"
                    command "curl -fsSL https://bun.sh/install | bash"
                }
                method {
                    context "macos/homebrew"
                    command "brew install oven-sh/bun/bun"
                }
            }
        }

        // ── Utilities ─────────────────────────────────────────────────────
        tool {
            id "jq"
            name "jq"
            description "Command-line JSON processor."
            categories "utility" "data"
            homepage "https://jqlang.org"
            docs "https://jqlang.org/manual/"
            verifyCommand "jq --version"
            launchCommand "jq"
            install {
                method {
                    context "linux/nix/default"
                    command "nix profile install nixpkgs#jq"
                    mutable false
                }
                method {
                    context "macos/homebrew"
                    command "brew install jq"
                }
                method {
                    context "windows/winget"
                    command "winget install jqlang.jq"
                }
                method {
                    context "linux/debian/default"
                    command "sudo apt install jq -y"
                }
            }
        }

        tool {
