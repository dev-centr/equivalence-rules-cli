                method {
                    context "macos/homebrew"
                    command "brew" "install" "--cask" "font-cascadia-mono"
                }
                method {
                    context "windows/choco"
                    command "choco" "install" "cascadiacode" "-y"
                    auditNote "Chocolatey cascadiacode; prefer the Mono cut in the host. Cascadia often already ships with Windows Terminal."
